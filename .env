# PostgreSQL
POSTGRES_USER=mdm_admin
POSTGRES_PASSWORD=mdm_secret
POSTGRES_DB=mdm_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Security
SECRET_KEY=super-secret-key-for-mdm-production-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=MDM System
APP_VERSION=1.0.0
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:3000", "http://localhost:5173"]

# Database URLs (for Docker)
DATABASE_URL=postgresql+asyncpg://mdm_admin:mdm_secret@postgres:5432/mdm_db
ASYNC_DATABASE_URL=postgresql+asyncpg://mdm_admin:mdm_secret@postgres:5432/mdm_db
REDIS_URL=redis://redis:6379/0
